{
  "client": {
    "source": "dist",
    "served_headers": {
      "X-Frame-Options": "ALLOW-FROM https://creator.zoho.com",
      "Content-Security-Policy": "frame-ancestors 'self' https://creator.zoho.com https://*.zoho.com"
    }
  },
  "functions": {
    "source": "functions",
    "targets": [
      "bridgex"
    ]
  },
  "apig": {
    "enabled": true,
    "cors": {
      "enabled": true,
      "allowed_origins": [
        "https://creator.zoho.com",
        "https://assetmanagement.onslate.com",
        "https://assetmanagementdev.onslate.com",
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "allowed_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowed_headers": [
        "Content-Type",
        "Authorization",
        "X-Requested-With",
        "X-Catalyst-User-ID"
      ],
      "max_age": 86400
    }
  }
}